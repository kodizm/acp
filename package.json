{
  "name": "@kodizm/acp",
  "version": "0.9.4",
  "description": "Custom ACP server bridging Claude Code and opencode CLIs through a single Kodizm-flavored protocol surface.",
  "type": "module",
  "bin": {
    "kodizm-acp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "test": "bun test test/unit test/e2e",
    "test:unit": "bun test test/unit",
    "test:e2e": "bun test test/e2e",
    "test:ci": "bun test test/unit test/e2e --path-ignore-patterns 'test/unit/backends/opencode/{http-bridge,driver-cancel-fork,driver-newsession}.test.ts' --path-ignore-patterns 'test/unit/live/daemon.test.ts' --path-ignore-patterns 'test/unit/util/debug-recorder.test.ts'",
    "test:integration": "./scripts/reap-opencode.sh bun test test/integration",
    "test:watch": "bun test --watch",
    "lint": "biome check src test scripts",
    "lint:fix": "biome check --write src test scripts",
    "format": "biome format --write src test scripts",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc --noEmit -p tsconfig.publish.json",
    "verify": "bun run typecheck:src && bun run lint && bun run test:ci",
    "prepublishOnly": "bun run build && bun run typecheck:src"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "claudeAgentSdk": "0.3.311"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311",
    "@anthropic-ai/sdk": ">=0.93.0",
    "@biomejs/biome": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.18.32",
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "zod": "^4.0.0"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/kodizm/acp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodizm/acp.git"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "claude",
    "opencode",
    "ai",
    "bridge",
    "jsonrpc"
  ]
}
